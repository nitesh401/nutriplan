digraph G {
  rankdir=TB; fontname="Helvetica"; nodesep=0.35; ranksep=0.55; bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#2E7D55", fillcolor="#F2F5F3", penwidth=1.3];
  edge [color="#14211C", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  labelloc=t; label="NutriPlan: Layered Architecture (Expo SDK 57, all on-device)"; fontsize=15;

  subgraph cluster_ui { label="Presentation layer (Expo Router screens)"; style="rounded,filled"; fillcolor="#E4ECE7"; color="#2E7D55";
    idx [label="app/index.tsx\nRoute guard"]; ob [label="app/onboarding.tsx\n5-step wizard + progress\n(Reanimated transitions)"]; db [label="app/dashboard.tsx\nPlan summary (FlashList)"]; }

  subgraph cluster_feat { label="Feature + component layer"; style="rounded,filled"; fillcolor="#E4ECE7"; color="#2E7D55";
    steps [label="features/onboarding/steps.tsx\nBasic | Body | Lifestyle | Health | Rules\n(React Hook Form)"];
    ui [label="components/ui.tsx\nInputs, chips, buttons"]; gauge [label="CalorieGauge.tsx + Bars.tsx\nSVG ring, animated bars"]; }

  subgraph cluster_val { label="Validation"; style="rounded,filled"; fillcolor="#FDF3E3"; color="#D9922B";
    zod [label="lib/schemas.ts\nZod schema per step"]; }

  subgraph cluster_state { label="State"; style="rounded,filled"; fillcolor="#E8EDF7"; color="#3F5FA8";
    store [label="store/useProfileStore.ts\nZustand: step + draft profile"]; as [label="AsyncStorage\n(persisted on device)", shape=cylinder, fillcolor="#FFFFFF"]; }

  subgraph cluster_dom { label="Domain layer (pure TypeScript, no UI imports)"; style="rounded,filled"; fillcolor="#F7E6EB"; color="#B5395B";
    engine [label="lib/nutritionEngine.ts\nBMR, TDEE, target, macros,\nwater, guardrails"]; meals [label="lib/mealPlanner.ts\nMeal timing, diet/allergy filter"];
    plan [label="lib/dietPlan.ts\nAssembles DietPlan"]; types [label="types/index.ts\nUserProfile, CalorieTarget, ...", fillcolor="#FFFFFF"]; }

  idx -> ob [label="no profile"]; idx -> db [label="profile complete"];
  ob -> steps; steps -> ui; steps -> zod [label="resolver"]; steps -> store [label="setSection()"];
  store -> as [dir=both, label="persist / hydrate"];
  db -> store [label="read draft"]; db -> plan [label="generateDietPlan()"]; db -> gauge;
  plan -> engine; plan -> meals; meals -> engine [style=dashed, label="targets"];
  engine -> types [style=dotted]; meals -> types [style=dotted]; store -> types [style=dotted];
}
